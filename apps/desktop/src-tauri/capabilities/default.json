{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: read and write the vault folder chosen by the user, open/save dialogs, Microsoft sign-in for OneDrive sync.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-stat",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://login.microsoftonline.com/*"
        }
      ]
    }
  ]
}
