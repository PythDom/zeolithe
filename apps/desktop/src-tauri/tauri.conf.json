{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeolite",
  "version": "0.1.0",
  "identifier": "org.zeolite.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "beforeBuildCommand": "npm --prefix ../.. run build"
  },
  "app": {
    "windows": [
      {
        "title": "Zeolite",
        "width": 1280,
        "height": 820,
        "minWidth": 400,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Notes in plain Markdown files",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
