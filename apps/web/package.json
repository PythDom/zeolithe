{
  "name": "@zeolite/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build:single": "vite build --mode single --outDir dist-single && node scripts/make-artifact.mjs",
    "build:portable": "vite build --mode single --outDir dist-portable && node -e \"require('fs').renameSync('dist-portable/index.html','dist-portable/Zeolite.html')\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@fontsource/roboto-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tombatossals/chords-db": "^0.5.1",
    "@zeolite/core": "*",
    "dompurify": "^3.2.7",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "pdfmake": "^0.3.11"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/markdown-it": "^14.1.2",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
