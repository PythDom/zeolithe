{
  "name": "zeolite",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @zeolite/web",
    "build": "npm run build -w @zeolite/web",
    "test": "npm test -w @zeolite/core",
    "check": "npm run check --workspaces --if-present",
    "taxonomy": "tsx scripts/taxonomy.ts",
    "build:portable": "npm run build:portable -w @zeolite/web"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
